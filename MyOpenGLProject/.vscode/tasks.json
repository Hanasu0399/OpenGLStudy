{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\MyOpenGLApp.exe",
                "${workspaceFolder}\\Lesson1.cpp",
                "${workspaceFolder}\\glad.c",
                "/I", "${workspaceFolder}\\include",
                "/I", "${workspaceFolder}\\glfw-3.4.bin.WIN64\\include",
                "/link",
                "${workspaceFolder}\\glfw-3.4.bin.WIN64\\lib-vc2022\\glfw3.lib",
                "opengl32.lib",
                "gdi32.lib",
                "user32.lib",
                "shell32.lib",
                "ucrt.lib",
                "vcruntime.lib",
                "msvcrt.lib",
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "OpenGL 项目编译任务"
        }
    ],
    "version": "2.0.0"
}